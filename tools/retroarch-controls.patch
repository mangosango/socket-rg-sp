+static void gl2_socket_quad(gl2_t *gl, GLuint texture, float x, float y,
+      float width, float height, float red, float green, float blue, float alpha)
+{
+   unsigned i;
+   GLfloat colors[16];
+   GLfloat left = x / gl->video_width;
+   GLfloat right = (x + width) / gl->video_width;
+   GLfloat top = 1.0f - y / gl->video_height;
+   GLfloat bottom = 1.0f - (y + height) / gl->video_height;
+   GLfloat vertices[8] = {left, top, right, top, left, bottom, right, bottom};
+   video_coords_t coords = gl->coords;
+   for (i = 0; i < 4; i++)
+   {
+      colors[4*i] = red;
+      colors[4*i+1] = green;
+      colors[4*i+2] = blue;
+      colors[4*i+3] = alpha;
+   }
+   coords.vertex = vertices;
+   coords.tex_coord = tex_coords;
+   coords.color = colors;
+   coords.vertices = 4;
+   glBindTexture(GL_TEXTURE_2D, texture);
+   gl->shader->set_coords(gl->shader_data, &coords);
+   gl->shader->set_mvp(gl->shader_data, &gl->mvp_no_rot);
+   glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+}
 
+static void gl2_socket_controls(gl2_t *gl)
+{
+   static socket_controls_t controls;
+   const unsigned char white[] = {255, 255, 255, 255};
+   const unsigned char *icon;
+   GLuint icon_texture;
+   int64_t now = cpu_features_get_time_usec();
+   int64_t age;
+   float alpha, level, bar_x = (gl->video_width - 320.0f) / 2.0f;
+   float warmth;
+   bool hud;
+   socket_controls_poll(&controls, now);
+   age = now - controls.shown_at;
+   hud = controls.shown_at && age < 1500000;
+   if (!hud && !controls.temperature)
+      return;
+   /* One white texture per GL context serves every solid quad and the tint. */
+   if (!gl->socket_white)
+   {
+      glGenTextures(1, &gl->socket_white);
+      glBindTexture(GL_TEXTURE_2D, gl->socket_white);
+      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+      glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, 1, 1, 0, GL_RGBA, GL_UNSIGNED_BYTE, white);
+   }
+   gl->shader->use(gl, gl->shader_data, VIDEO_SHADER_STOCK_BLEND, true);
+   glViewport(0, 0, gl->video_width, gl->video_height);
+   glEnable(GL_BLEND);
+   glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
+   glBlendEquation(GL_FUNC_ADD);
+   if (hud)
+   {
+      alpha = age < 1250000 ? 1.0f : (1500000 - age) / 250000.0f;
+      level = controls.kind == 2 ? controls.brightness / 9.0f :
+         controls.kind == 3 ? controls.temperature / 9.0f : controls.volume / 100.0f;
+      icon = controls.kind == 2 ? socket_control_icon_brightness :
+         controls.kind == 3 ? socket_control_icon_temperature :
+         (controls.volume ? socket_control_icon_volume : socket_control_icon_volume_zero);
+      gl2_socket_quad(gl, gl->socket_white, 0, 0, gl->video_width, 40, 0, 0, 0, .72f * alpha);
+      gl2_socket_quad(gl, gl->socket_white, bar_x, 17, 320, 6, 1, 1, 1, .18f * alpha);
+      if (level > 0)
+         gl2_socket_quad(gl, gl->socket_white, bar_x, 17, 320 * level, 6,
+               245/255.0f, 242/255.0f, 239/255.0f, alpha);
+      /* The icon texture exists only while the 1.5 second overlay is visible. */
+      glGenTextures(1, &icon_texture);
+      glBindTexture(GL_TEXTURE_2D, icon_texture);
+      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+      glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, SOCKET_CONTROL_ICON_WIDTH,
+            SOCKET_CONTROL_ICON_HEIGHT, 0, GL_RGBA, GL_UNSIGNED_BYTE, icon);
+      gl2_socket_quad(gl, icon_texture, bar_x - 10 - SOCKET_CONTROL_ICON_WIDTH,
+            (40 - SOCKET_CONTROL_ICON_HEIGHT) / 2.0f,
+            SOCKET_CONTROL_ICON_WIDTH, SOCKET_CONTROL_ICON_HEIGHT, 1, 1, 1, alpha);
+      glDeleteTextures(1, &icon_texture);
+   }
+   if (controls.temperature)
+   {
+      /* Slot grade.rs: multiply the whole frame, HUD included, toward [1, .82, .62]. */
+      warmth = controls.temperature / 9.0f;
+      glBlendFunc(GL_DST_COLOR, GL_ZERO);
+      gl2_socket_quad(gl, gl->socket_white, 0, 0, gl->video_width, gl->video_height,
+            1.0f, 1.0f - .18f * warmth, 1.0f - .38f * warmth, 1.0f);
+      glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
+   }
+   glDisable(GL_BLEND);
+   glViewport(gl->vp.x, gl->vp.y, gl->vp.width, gl->vp.height);
+   gl->shader->set_coords(gl->shader_data, &gl->coords);
+   gl->shader->set_mvp(gl->shader_data, &gl->mvp);
+}
