+// Tile MSAA loses its depth when a frame copies the screen or the depth.
+// Set true for such a frame. The frame then uses MSAA render buffers.
+void RenderSceneBuffersGLES3::set_msaa_explicit_resolve(bool p_explicit) {
+	p_explicit = p_explicit && GLES3::Config::get_singleton()->rt_msaa_supported && view_count == 1 && msaa3d.mode != RSE::VIEWPORT_MSAA_DISABLED;
+	if (msaa3d.explicit_resolve != p_explicit) {
+		msaa3d.explicit_resolve = p_explicit;
+		_clear_msaa3d_buffers();
+	}
+}
